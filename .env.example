# Copy to .env for local development. Never commit .env.
# Matches the credentials in docker-compose.yml (local only).
DATABASE_URL=postgresql://vrag:vrag@localhost:5433/vrag

# Finance pack: SEC fair-access policy requires a User-Agent with contact details.
# Format: "AppName contact-email". Keep the real value only in .env.
VRAG_FINANCE_SEC_USER_AGENT=VerifiedRAG your-email@example.com
